# LLM（阿里云百炼 DashScope，OpenAI 兼容协议）
DASHSCOPE_API_KEY=sk-your-key-here
AGENT_LLM_MODEL=qwen3.8-flash
AGENT_LLM_MODEL_COMPRESS=qwen-turbo
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 目标仓库（agent 在这里改代码）
AGENT_REPO_ROOT=/absolute/path/to/your/repo
AGENT_TARGET_BRANCH=
AGENT_AUTO_MERGE=true

# 预算控制
AGENT_MAX_ITERATIONS=30
AGENT_MAX_TOKENS=200000
AGENT_MAX_DURATION_SECONDS=600
AGENT_MAX_PROJECT_TOKENS=800000
AGENT_MAX_PROJECT_DURATION=7200

# 沙箱（DSW 环境建议 off）
AGENT_SANDBOX_ENABLED=off

# 检索（market-research-agent 用）
TAVILY_API_KEY=tvly-your-key-here
